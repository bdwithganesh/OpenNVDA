    mesa_shader_stage stage = state->stage;
    bool is_divergent = false;
 
+   /* macOS NAK: on NVIDIA, helper pixels skip memory loads and read 0, so a
+    * load from a uniform address in a fragment shader is not uniform once
+    * helpers share the warp (R2UR could take a helper's zero).
+    */
+   if (stage == MESA_SHADER_FRAGMENT) {
+      switch (instr->intrinsic) {
+      case nir_intrinsic_load_global:
+      case nir_intrinsic_load_global_2x32:
+      case nir_intrinsic_load_global_constant:
+      case nir_intrinsic_load_ssbo:
+      case nir_intrinsic_global_atomic:
+      case nir_intrinsic_global_atomic_swap:
+         instr->def.divergent = true;
+         return true;
+      default:
+         break;
+      }
+   }
+
    switch (instr->intrinsic) {
    case nir_intrinsic_shader_clock:
    case nir_intrinsic_ballot:

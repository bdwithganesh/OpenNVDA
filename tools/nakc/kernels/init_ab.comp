#version 460
#extension GL_EXT_buffer_reference : require
layout(local_size_x = 256) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Mat { float v[]; };
layout(push_constant) uniform Push { Mat a; Mat b; uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n * p.n) return;
    uint r = i / p.n, c = i % p.n;
    p.a.v[i] = float((r + 2u * c) % 7u) - 3.0;
    p.b.v[i] = float((3u * r + c) % 5u) - 2.0;
}
